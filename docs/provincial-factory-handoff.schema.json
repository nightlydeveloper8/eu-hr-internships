{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Untrusted provincial verification candidates v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidates"],
  "properties": {
    "schema_version": {"const": 1},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["employer", "official_career_url", "municipality", "evidence_url", "observed_at", "confidence", "review_status"],
        "properties": {
          "employer": {"type": "string", "minLength": 1, "maxLength": 1000},
          "official_career_url": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 1000},
          "municipality": {"type": "string", "minLength": 1, "maxLength": 1000},
          "evidence_url": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 1000},
          "observed_at": {"type": "string", "format": "date-time", "maxLength": 1000},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "review_status": {"type": "string", "minLength": 1, "maxLength": 1000, "description": "Untrusted claim. Import always sets effective review_status=pending."}
        }
      }
    }
  }
}
